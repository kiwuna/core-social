# Server Configuration
PORT=3000
MAX_POST_LENGTH=300
SESSION_SECRET=core-social-secret-key-change-this-in-production

# Database Configuration (PostgreSQL)
#
# LOCAL DEVELOPMENT:
# Install PostgreSQL and create a database named 'core_social'
# Windows: Use pgAdmin or command line: createdb core_social
# MacOS: brew install postgresql && brew services start postgresql && createdb core_social
# Linux: sudo apt-get install postgresql && sudo -u postgres createdb core_social
#
# SUPABASE:
# Get connection string from Supabase Dashboard → Settings → Database
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# SSL Configuration:
# Set to 'true' for Supabase or other cloud providers
# Set to 'false' or leave empty for local PostgreSQL
#
DATABASE_URL=postgresql://postgres:Giogio111223@localhost:5432/core_social
DATABASE_SSL=true

# Cloudflare Origin Protection (Optional - DISABLE for local development)
# Set to 'cloudflare_ips_only' to restrict access to Cloudflare IPs only
# Leave empty or comment out for local development
# CLOUDFLARE_ORIGIN_RULES=cloudflare_ips_only

# Cloudinary Configuration (Required for image uploads)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Configuration (Required for premium features)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Web Push Notifications (Optional - for browser push notifications)
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Application URL (for OAuth callbacks, redirects, and metadata)
# Local development: http://localhost:3000
# Production: https://yourdomain.com
APP_URL=http://localhost:3000
